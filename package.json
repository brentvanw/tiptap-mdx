{
  "name": "tiptap-mdx",
  "version": "0.1.0",
  "description": "A lossless MDX <-> Tiptap (ProseMirror) bridge with a round-trip-identity invariant: parse a document and re-serialize it byte-for-byte.",
  "license": "MIT",
  "author": "Goods",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodsventures/tiptap-mdx.git"
  },
  "homepage": "https://github.com/goodsventures/tiptap-mdx#readme",
  "bugs": {
    "url": "https://github.com/goodsventures/tiptap-mdx/issues"
  },
  "keywords": [
    "mdx",
    "tiptap",
    "prosemirror",
    "markdown",
    "editor",
    "remark",
    "round-trip",
    "wysiwyg"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.13.5",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
